import base64
import hashlib
import json
import os
import zlib

from android_utils import run_on_ui_thread
from base_plugin import AppEvent, BasePlugin, MethodHook
from hook_utils import find_class
from java import jclass
from java.lang import Boolean, Thread
from org.telegram.messenger import ApplicationLoader
from ui.bulletin import BulletinHelper

__id__ = "accounts_limit_100"
__name__ = "100 Accounts"
__description__ = "Experimental account limit up to 100 for exteraGram 12.5.1."
__author__ = "@kvucoplugins"
__version__ = "1.0"
__icon__ = "PremiumGifts/23"
__app_version__ = "==12.5.1"
__sdk_version__ = ">=1.4.0"

ENTRY_CLASS = "com.kvuco.account100.Account100Bridge"
DEX_SHA256 = "1340c46a6b40394e9f1f2df0addf20f0b965d652e010f4f79bc9272df042d720"
RUNTIME_GENERATION = "1.0"
KEEPER_NAME = "account100-dex-keeper:" + RUNTIME_GENERATION + ":" + DEX_SHA256
DEX_BEGIN = "__DEX_BEGIN__"
DEX_END = "__DEX_END__"
NATIVE_BEGIN = "__NATIVE_BEGIN__"
NATIVE_END = "__NATIVE_END__"
NATIVE_FILE_MODE = 0o500

Build = jclass("android.os.Build")
BuildVersion = jclass("android.os.Build$VERSION")
Process = jclass("android.os.Process")


def _is_java_true(value):
    return value is True or str(value).lower() == "true"


def _read_payload(begin_name, end_name):
    with open(__file__, "r", encoding="utf-8") as source:
        text = source.read()
    block = text.split("# " + begin_name, 1)[1].split("# " + end_name, 1)[0]
    payload = "".join(
        line.strip()[1:].strip()
        for line in block.splitlines()
        if line.strip().startswith("#")
    )
    if not payload:
        raise RuntimeError("Embedded payload is empty")
    return zlib.decompress(base64.b64decode(payload))


def _read_dex_payload():
    payload = _read_payload(DEX_BEGIN, DEX_END)
    if hashlib.sha256(payload).hexdigest() != DEX_SHA256:
        raise RuntimeError("DEX payload digest mismatch")
    return payload


def _matches_digest(path, expected_size, expected_sha):
    try:
        if os.path.getsize(path) != expected_size:
            return False
        digest = hashlib.sha256()
        with open(path, "rb") as source:
            while True:
                chunk = source.read(32768)
                if not chunk:
                    break
                digest.update(chunk)
        return digest.hexdigest() == expected_sha
    except Exception:
        return False


def _current_abi(available):
    abis = Build.SUPPORTED_64_BIT_ABIS if Process.is64Bit() else Build.SUPPORTED_32_BIT_ABIS
    if abis is None or len(abis) == 0:
        raise RuntimeError("ABI списка текущего процесса недоступен")
    for value in abis:
        abi = str(value)
        if abi in available:
            return abi
    raise RuntimeError("Неподдерживаемая ABI процесса: " + ", ".join(map(str, abis)))


def _check_environment():
    if int(BuildVersion.SDK_INT) < 26:
        raise RuntimeError("100 Accounts требует Android 8.0 (API 26) или новее")
    if ApplicationLoader.applicationContext is None:
        raise RuntimeError("Контекст приложения ещё не готов")


def _extract_native():
    bundle = json.loads(_read_payload(NATIVE_BEGIN, NATIVE_END).decode("utf-8"))
    libs = bundle.get("libs")
    if bundle.get("format") != 2 or not isinstance(libs, dict):
        raise RuntimeError("Native payload schema is invalid")
    abi = _current_abi(libs)
    item = libs.get(abi)
    if not isinstance(item, dict):
        raise RuntimeError("Native payload is missing for " + abi)
    raw = base64.b64decode(str(item.get("data") or ""))
    expected_size = int(item.get("size") or 0)
    expected_sha = str(item.get("sha256") or "").lower()
    expected_class = int(item.get("elf_class") or 0)
    expected_machine = int(item.get("elf_machine") or 0)
    if len(raw) != expected_size or hashlib.sha256(raw).hexdigest() != expected_sha:
        raise RuntimeError("Native payload digest mismatch")
    if len(raw) < 20 or raw[:4] != b"\x7fELF":
        raise RuntimeError("Native payload is not ELF")
    if expected_class not in (1, 2) or int(raw[4]) != expected_class or int(raw[5]) != 1:
        raise RuntimeError("Native payload ELF class mismatch")
    machine = int(raw[18]) | (int(raw[19]) << 8)
    if expected_machine <= 0 or machine != expected_machine:
        raise RuntimeError("Native payload ABI mismatch")

    context = ApplicationLoader.applicationContext
    if context is None:
        raise RuntimeError("Application context is not ready")
    root = str(context.getDir("accountLimit100", 0).getAbsolutePath())
    target_dir = os.path.join(root, __version__, abi)
    os.makedirs(target_dir, exist_ok=True)
    target = os.path.join(target_dir, "libaccount100_tgnet.so")
    if not _matches_digest(target, expected_size, expected_sha):
        staged = target + ".tmp"
        try:
            with open(staged, "wb") as output:
                output.write(raw)
                output.flush()
                os.fsync(output.fileno())
            os.chmod(staged, NATIVE_FILE_MODE)
            os.replace(staged, target)
        except Exception:
            try:
                os.unlink(staged)
            except Exception:
                pass
            raise
    os.chmod(target, NATIVE_FILE_MODE)
    return target


class DexRuntime:
    def __init__(self):
        self.loader = None
        self.bridge = None
        self.method_cache = {}

    def prepare(self):
        if self.bridge is not None:
            return
        _check_environment()
        retained = self._find_retained()
        if retained is None:
            context = ApplicationLoader.applicationContext
            ByteBuffer = jclass("java.nio.ByteBuffer")
            InMemoryDexClassLoader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = InMemoryDexClassLoader(
                ByteBuffer.wrap(_read_dex_payload()),
                context.getClassLoader(),
            )
        else:
            self.loader = retained
        self.bridge = self.loader.loadClass(ENTRY_CLASS)

    @staticmethod
    def _find_retained():
        matches = []
        incompatible = []
        for thread in Thread.getAllStackTraces().keySet().toArray():
            try:
                name = str(thread.getName() or "")
            except Exception:
                continue
            if not name.startswith("account100-dex-keeper:"):
                continue
            if name == KEEPER_NAME:
                matches.append(thread)
            else:
                incompatible.append(name)
        if incompatible:
            raise RuntimeError("Another 100 Accounts runtime is loaded; restart exteraGram")
        if not matches:
            return None
        if len(matches) != 1:
            raise RuntimeError("Ambiguous 100 Accounts runtime; restart exteraGram")
        loader = matches[0].getContextClassLoader()
        if loader is None:
            raise RuntimeError("Retained DEX has no class loader")
        return loader

    def invoke(self, name, *args):
        self.prepare()
        key = (name, len(args))
        if key not in self.method_cache:
            matches = []
            for method in self.bridge.getDeclaredMethods():
                if (
                    str(method.getName()) == name
                    and len(method.getParameterTypes()) == len(args)
                ):
                    method.setAccessible(True)
                    matches.append(method)
            if len(matches) != 1:
                raise RuntimeError("Invalid bridge method: %s/%d" % key)
            self.method_cache[key] = matches[0]
        return self._invoke_method(self.method_cache[key], args)

    @staticmethod
    def _invoke_method(method, args):
        try:
            return method.invoke(None, *args)
        except Exception as exc:
            messages = []
            try:
                cause = exc.getCause()
            except Exception:
                cause = None
            for _ in range(8):
                if cause is None:
                    break
                try:
                    message = str(cause.getMessage() or cause)
                except Exception:
                    message = str(cause)
                if message and message not in messages:
                    messages.append(message)
                try:
                    next_cause = cause.getCause()
                except Exception:
                    next_cause = None
                if next_cause is cause:
                    break
                cause = next_cause
            if messages:
                raise RuntimeError(" -> ".join(messages))
            raise


class GenerationMethodHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        self.generation = plugin.hook_generation

    def is_active(self):
        try:
            return (
                self.plugin.active
                and self.generation == self.plugin.hook_generation
            )
        except Exception:
            return False


class ValidAccountHook(GenerationMethodHook):

    def before_hooked_method(self, param):
        if not self.is_active():
            return
        try:
            if not param.args:
                return
            account = int(param.args[0])
            state = int(self.plugin.dex.invoke("extraAccountState", account))
            if state >= 0:
                param.setResult(Boolean(state != 0))
        except Exception as exc:
            self.plugin.log_once("valid_account", "isValidAccount hook failed: %s" % exc)


class CanAddAccountHook(GenerationMethodHook):

    def before_hooked_method(self, param):
        if not self.is_active():
            return
        try:
            param.setResult(Boolean(self.plugin.first_free_account() >= 0))
        except Exception as exc:
            self.plugin.log_once("can_add", "canAddAccount hook failed: %s" % exc)


class OpenAddAccountHook(GenerationMethodHook):

    def before_hooked_method(self, param):
        if not self.is_active():
            return
        try:
            opened = self.plugin.dex.invoke("openNextAccount", param.thisObject)
            if not _is_java_true(opened):
                BulletinHelper.show_error("Достигнут лимит в 100 аккаунтов")
            param.setResult(None)
        except Exception as exc:
            self.plugin.log_once("open_add", "openAddAccountFlow hook failed: %s" % exc)
            BulletinHelper.show_error("Не удалось открыть добавление аккаунта")
            param.setResult(None)


class AccountSelectorHook(GenerationMethodHook):

    def before_hooked_method(self, param):
        if not self.is_active():
            return
        try:
            if len(param.args) != 3:
                raise RuntimeError(
                    "Unexpected openAccountSelectorInternal signature"
                )
            shown = self.plugin.dex.invoke(
                "showStockAccountSelector",
                param.thisObject,
                param.args[0],
                param.args[1],
                param.args[2],
            )
            if _is_java_true(shown):
                param.setResult(None)
        except Exception as exc:
            self.plugin.log_once(
                "account_selector",
                "openAccountSelectorInternal hook failed: %s" % exc,
            )


class DrawerAccountsHook(GenerationMethodHook):

    def before_hooked_method(self, param):
        if not self.is_active():
            return
        try:
            badge = param.args[0] if param.args else None
            self.plugin.dex.invoke(
                "loadDrawerAccounts",
                param.thisObject,
                badge,
            )
            param.setResult(None)
        except Exception as exc:
            self.plugin.log_once(
                "drawer_accounts",
                "DrawerAccountPickerView.loadAccounts hook failed: %s" % exc,
            )


class DrawerOpenAddAccountHook(GenerationMethodHook):

    def before_hooked_method(self, param):
        if not self.is_active():
            return
        try:
            opened = self.plugin.dex.invoke("openNextDrawerAccount")
            if not _is_java_true(opened):
                BulletinHelper.show_error("Достигнут лимит в 100 аккаунтов")
            param.setResult(None)
        except Exception as exc:
            self.plugin.log_once(
                "drawer_open_add",
                "DrawerAccountPickerView.openAddAccountFlow hook failed: %s"
                % exc,
            )
            BulletinHelper.show_error("Не удалось открыть добавление аккаунта")
            param.setResult(None)


class AvailableAccountHook(GenerationMethodHook):

    def before_hooked_method(self, param):
        if not self.is_active():
            return
        try:
            switched = self.plugin.dex.invoke("switchToAvailableExtra")
            if _is_java_true(switched):
                param.setResult(None)
        except Exception as exc:
            self.plugin.log_once(
                "available_account",
                "switchToAvailableAccountOrLogout hook failed: %s" % exc,
            )


class AccountLimit100Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex = DexRuntime()
        self.unhooks = []
        self.logged = set()
        self.active = False
        self.hook_generation = 0

    def on_plugin_load(self):
        self.logged.clear()
        self.active = False
        try:
            if not self._clear_hooks():
                raise RuntimeError("Previous UI hooks could not be removed; restart exteraGram")
            _check_environment()
            native_path = _extract_native()
            expanded = int(self.dex.invoke("install", native_path, KEEPER_NAME))
            probe_time = int(self.dex.invoke("runSelfTest"))
            preloaded = int(self.dex.invoke("preloadExtraAccountConfigs"))
            self._install_hooks()
            paused = _is_java_true(ApplicationLoader.mainInterfacePaused)
            self.dex.invoke("setExtraAccountsPaused", paused)
            self.active = True
            self._schedule_lifecycle_reconciliation()
            self.log(
                "100 Accounts runtime ready; expanded fields: %d; preloaded accounts: %d; native route self-test: %d"
                % (expanded, preloaded, probe_time)
            )
        except Exception:
            self.active = False
            self._clear_hooks()
            if self.dex.bridge is not None:
                try:
                    self.dex.invoke("prepareForUnload")
                except Exception:
                    pass
                try:
                    self.dex.invoke("setExtraAccountsPaused", True)
                except Exception:
                    pass
            raise

    def on_plugin_unload(self):
        self.active = False
        if not self._clear_hooks():
            self.log("Some UI hooks could not be removed; restart exteraGram")
        try:
            prepared = self.dex.invoke("prepareForUnload")
            if not _is_java_true(prepared):
                self.log("Unload preparation did not complete")
        except Exception as exc:
            self.log("Unload preparation failed: %s" % exc)
        try:
            self.dex.invoke("setExtraAccountsPaused", True)
        except Exception as exc:
            self.log("Could not pause extra accounts: %s" % exc)

    def on_app_event(self, event_type):
        if not self.active:
            return
        if event_type == AppEvent.RESUME:
            try:
                self.dex.invoke("setExtraAccountsPaused", False)
            except Exception as exc:
                self.log_once("resume_accounts", "Resume failed: %s" % exc)
        elif event_type in (AppEvent.PAUSE, AppEvent.STOP):
            try:
                self.dex.invoke("setExtraAccountsPaused", True)
            except Exception as exc:
                self.log_once("pause_accounts", "Pause failed: %s" % exc)

    def first_free_account(self):
        return int(self.dex.invoke("firstFreeAccount"))

    def _schedule_lifecycle_reconciliation(self):
        generation = self.hook_generation

        def reconcile(attempts):
            try:
                if not self.active or generation != self.hook_generation:
                    return
                if not _is_java_true(getattr(self, "enabled", False)):
                    if attempts > 1:
                        run_on_ui_thread(lambda: reconcile(attempts - 1), 50)
                    return
                paused = _is_java_true(ApplicationLoader.mainInterfacePaused)
                self.dex.invoke("setExtraAccountsPaused", paused)
            except Exception as exc:
                self.log_once(
                    "lifecycle_reconciliation",
                    "Lifecycle reconciliation failed: %s" % exc,
                )

        try:
            run_on_ui_thread(lambda: reconcile(20))
        except Exception as exc:
            self.log_once(
                "schedule_lifecycle_reconciliation",
                "Could not schedule lifecycle reconciliation: %s" % exc,
            )

    def _install_hooks(self):
        user_config = find_class("org.telegram.messenger.UserConfig")
        if user_config is None:
            raise RuntimeError("UserConfig class not found")
        self._require_hook(
            user_config,
            "isValidAccount",
            ValidAccountHook(self),
        )

        main_tabs = find_class("org.telegram.ui.MainTabsActivity")
        if main_tabs is None:
            raise RuntimeError("MainTabsActivity class not found")
        self._require_hook(
            main_tabs,
            "canAddAccount",
            CanAddAccountHook(self),
        )
        self._require_hook(
            main_tabs,
            "openAddAccountFlow",
            OpenAddAccountHook(self),
        )
        self._require_hook(
            main_tabs,
            "openAccountSelectorInternal",
            AccountSelectorHook(self),
        )

        drawer_picker = find_class(
            "com.exteragram.messenger.drawer.DrawerAccountPickerView"
        )
        if drawer_picker is None:
            raise RuntimeError("DrawerAccountPickerView class not found")
        self._require_hook(
            drawer_picker,
            "loadAccounts",
            DrawerAccountsHook(self),
            expected_count=2,
        )
        self._require_hook(
            drawer_picker,
            "canAddAccount",
            CanAddAccountHook(self),
        )
        self._require_hook(
            drawer_picker,
            "openAddAccountFlow",
            DrawerOpenAddAccountHook(self),
        )

        launch = find_class("org.telegram.ui.LaunchActivity")
        if launch is None:
            raise RuntimeError("LaunchActivity class not found")
        self._require_hook(
            launch,
            "switchToAvailableAccountOrLogout",
            AvailableAccountHook(self),
        )

    def _require_hook(
        self,
        target,
        method_name,
        hook,
        expected_count=1,
    ):
        count = self._keep_unhooks(
            self.hook_all_methods(
                target,
                method_name,
                hook,
                priority=10000,
            )
        )
        if count != expected_count:
            self._clear_hooks()
            raise RuntimeError(
                "Expected %d hook(s) for %s, got %d"
                % (expected_count, method_name, count)
            )

    def _keep_unhooks(self, unhooks):
        if not unhooks:
            return 0
        try:
            items = list(unhooks)
        except TypeError:
            items = [unhooks]
        items = [item for item in items if item is not None]
        self.unhooks.extend(items)
        return len(items)

    def _clear_hooks(self):
        self.hook_generation = int(getattr(self, "hook_generation", 0)) + 1
        retained = []
        for unhook in reversed(list(getattr(self, "unhooks", []))):
            try:
                self.unhook_method(unhook)
            except Exception as exc:
                retained.append(unhook)
                self.log_once(
                    "unhook_%d" % id(unhook),
                    "Could not remove UI hook: %s" % exc,
                )
        retained.reverse()
        self.unhooks[:] = retained
        return not retained

    def log_once(self, key, message):
        if key in self.logged:
            return
        self.logged.add(key)
        self.log(message)


