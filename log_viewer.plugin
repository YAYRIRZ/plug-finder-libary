from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment
from ui.alert import AlertDialogBuilder
from hook_utils import find_class
from ui.bulletin import BulletinHelper
from java.lang import String, Throwable
from java.util import Locale
from ui.settings import Text, Input, Switch
from collections import deque
from datetime import datetime

__id__ = "log-viewer"
__name__ = "Log Viewer"
__description__ = "Saves logs and lets you view them"
__author__ = "@PESSDES"
__min_version__ = "11.12.0"
__icon__ = "FluentEmoji5/28"
__version__ = "1.0"

def show_alert(message:str, title: str):
            current_fragment = get_last_fragment()
            current_activity = current_fragment.getParentActivity()

            progress_dialog_builder = AlertDialogBuilder(
                current_activity,
                AlertDialogBuilder.ALERT_TYPE_MESSAGE
            )
            progress_dialog_builder.set_message(message=message)
            progress_dialog_builder.set_title(title=title)
            progress_dialog_builder.show()
            progress_dialog_builder.set_cancelable(True)

class Localization:
    def __init__(self):
        self.language = Locale.getDefault().getLanguage()
        self.language = self.language if self.language in self._get_supported_languages() else "en"
        
    def get_string(self, string_key):
        return self.strings[self.language].get(string_key, self.strings["en"].get(string_key, string_key))

    def _get_supported_languages(self):
        return self.strings.keys() 
    
    def __getitem__(self, key):
        return self.get_string(key)
    
    strings = {
        "ru": {
            "APP_UTILS_CLASS_NOT_FOUND": "Не удалось найти класс AppUtils",
            "LOG_INTERNAL_METHOD_NOT_FOUND": "Не удалось найти метод logInternal",
            "HOOK_FAILED": "Не удалось хукнуть метод logInternal",
            "SHOW_LOGS": "Показать логи",
            "MAX_LOGS": "Максимальное количество логов",
            "MAX_LOGS_SUBTEXT": "Определяет максимальную длину массива логов. Только числа.",
            "SHOW_DATE": "Показывать дату логов",
            "CLEAR_LOGS": "Очистить буффер логов",
        },
        "en": {
            "APP_UTILS_CLASS_NOT_FOUND": "AppUtils class not found",
            "LOG_INTERNAL_METHOD_NOT_FOUND": "logInternal method not found",
            "HOOK_FAILED": "Hook failed",
            "SHOW_LOGS": "View logs",
            "MAX_LOGS": "Max logs count",
            "MAX_LOGS_SUBTEXT": "Determines the maximum length of the log array. Only numbers.",
            "SHOW_DATE": "Show date",
            "CLEAR_LOGS": "Clear logs"
        }
    }

strings = Localization()

max_len = 100
logs = deque(maxlen=max_len)

class LogViewerPlugin(BasePlugin):
    def on_plugin_load(self):
        AppUtils = find_class("com.exteragram.messenger.utils.AppUtils")
        if not AppUtils:
            error = strings["APP_UTILS_CLASS_NOT_FOUND"]
            self.log(error)
            BulletinHelper.show_error(f'[Log Viewer] f{error}')
            return
        try:
            IntegerType = find_class("java.lang.Integer").TYPE

            method_to_hook = AppUtils.getClass().getDeclaredMethod("logInternal", String, Throwable, IntegerType)
            method_to_hook.setAccessible(True)
        except Exception as e:
            error = strings["LOG_INTERNAL_METHOD_NOT_FOUND"]
            self.log(f'{error}: {e}')
            BulletinHelper.show_error(f'[Log Viewer] {error}: {e}')
        
        handler_instance = LogHooker(self)
        unhook_obj = self.hook_method(method_to_hook, handler_instance, 10)
        
        if not unhook_obj:
            error = strings["HOOK_FAILED"]
            self.log(error)
            BulletinHelper.show_error(f'[Log Viewer] {error}')
    
    def create_settings(self):
         return [
             Text(
                 text=f"{strings['SHOW_LOGS']} ({f'{logs.maxlen}+' if logs.__len__() > logs.maxlen else logs.__len__().__str__()})", 
                 icon="filled_views",
                 on_click=self.show_logs),
             Input(
                 key="max_len",
                 text=strings["MAX_LOGS"], 
                 default=100, 
                 subtext=strings["MAX_LOGS_SUBTEXT"],
                 on_change=self.on_maxlen_change
             ),
             Switch(
                 key="show_date",
                 text=strings["SHOW_DATE"],
                 default=True,
                 icon="input_calendar1"
             ),
             Text(
                 text=strings["CLEAR_LOGS"],
                 icon="msg_clearcache",
                 red = True,
                 on_click=self.clear_logs
             )
         ]
         
    def on_maxlen_change(self, value: str):
        if value.isdigit():
            max_len = int(value)
            logs = deque(logs, maxlen=max_len)
        else:
            self.set_setting("max_len", max_len.__str__())
      
    def clear_logs(self, view):
        logs.clear()
      
    def show_logs(self, view):
        str_logs = "\n".join(map(lambda x: f'[{x.date}] {x.message}' if self.get_setting("show_date", True) else x.message, logs))
        show_alert(str_logs, "Login Viewer")

class Log:
    def __init__(self, message):
        self.message = message
        self.date = datetime.now().time()
    
   
class LogHooker(MethodHook):
    
    def __init__(self, plugin):
        self.plugin = plugin
        
    def before_hooked_method(self, param):
        logs.append(Log(param.args[0]))