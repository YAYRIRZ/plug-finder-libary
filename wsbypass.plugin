# Primary source + jsDelivr mirrors. The mirrors stay reachable when RKN blocks
# raw.githubusercontent.com, so the CF domain pool keeps refreshing from Flowseal
# instead of being stuck on the baked-in defaults.
CFPROXY_DOMAINS_URLS = (
    "https://raw.githubusercontent.com/Flowseal/tg-ws-proxy/main/.github/cfproxy-domains.txt",
    "https://cdn.jsdelivr.net/gh/Flowseal/tg-ws-proxy@main/.github/cfproxy-domains.txt",
    "https://fastly.jsdelivr.net/gh/Flowseal/tg-ws-proxy@main/.github/cfproxy-domains.txt",
)
_TGWS_CFPROXY_ENC = [
    "virkgj.com",
    "vmmzovy.com",
    "mkuosckvso.com",
    "zaewayzmplad.com",
    "twdmbzcm.com",
    "awzwsldi.com",
    "clngqrflngqin.com",
    "tjacxbqtj.com",
    "bxaxtxmrw.com",
    "dmohrsgmohcrwb.com",
    "vwbmtmoi.com",
    "khgrre.com",
    "ulihssf.com",
    "tmhqsdqmfpmk.com",
    "xwuwoqbm.com",
]
_TGWS_CFPROXY_S = "".join(chr(c) for c in (46, 99, 111, 46, 117, 107))
_TGWS_HOST_RE = re.compile(
    r"^(?=.{1,253}$)(?!-)[A-Za-z0-9-]{1,63}(?<!-)(?:\.(?!-)[A-Za-z0-9-]{1,63}(?<!-))+$"
)
_TGWS_MAX_DOMAINS = 256
def _tgws_valid_host(h):
    try:
        s = str(h or "").strip().lower()
    except Exception:
        return None
    if not s or len(s) > 253 or ".." in s:
        return None
    if not _TGWS_HOST_RE.match(s):
        return None
    return s
def _tgws_dd(s):
    try:
        ss = str(s or "")
    except Exception:
        return s
    if not ss.endswith(".com"):
        return ss
    p = ss[:-4]
    try:
        n = sum(1 for c in p if ("a" <= c <= "z") or ("A" <= c <= "Z"))
    except Exception:
        n = 0
    out = []
    for c in p:
        o = ord(c)
        if 97 <= o <= 122:
            out.append(chr((o - 97 - n) % 26 + 97))
        elif 65 <= o <= 90:
            out.append(chr((o - 65 - n) % 26 + 65))
        else:
            out.append(c)
    return "".join(out) + _TGWS_CFPROXY_S
def _tgws_fetch_cfproxy_domains():
    # Try each source in order; the first one that yields valid domains wins. A
    # cache-buster is appended so blocked-but-cached responses don't mask a fresh
    # list. Falls through to the next mirror on any error / non-200 / empty parse.
    cb = "".join(random.choices("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", k=7))
    for base in CFPROXY_DOMAINS_URLS:
        try:
            url = str(base) + "?" + cb
            r = requests.get(url, timeout=10, headers={"User-Agent": "tg-ws-proxy"}, verify=_CA_BUNDLE)
            if getattr(r, "status_code", 0) != 200:
                continue
            text = str(getattr(r, "text", "") or "")
            if len(text) > 65536:
                text = text[:65536]
            out = []
            seen = set()
            for line in text.splitlines():
                s = str(line or "").strip()
                if not s or s.startswith("#"):
                    continue
                dd = _tgws_valid_host(_tgws_dd(s))
                if dd and dd not in seen:
                    seen.add(dd)
                    out.append(dd)
                    if len(out) >= _TGWS_MAX_DOMAINS:
                        break
            if out:
                return out
        except Exception:
            continue
    return []
_tgws_cf_refresh_stop = threading.Event()
def _tgws_start_cfproxy_domain_refresh(on_update):
    global _tgws_cf_refresh_stop
    try:
        _tgws_cf_refresh_stop.set()
    except Exception:
        pass
    _tgws_cf_refresh_stop = threading.Event()
    stop = _tgws_cf_refresh_stop
    try:
        defaults = [h for h in (_tgws_valid_host(_tgws_dd(d)) for d in list(_TGWS_CFPROXY_ENC)) if h]
    except Exception:
        defaults = []
    try:
        if callable(on_update):
            on_update(defaults)
    except Exception:
        pass
    def _loop():
        try:
            try:
                first_delay = max(0.0, float(TGWS_CF_REFRESH_DELAY_SEC))
            except Exception:
                first_delay = 25.0
            try:
                if stop.wait(timeout=first_delay):
                    return
            except Exception:
                return
            try:
                pool = _tgws_fetch_cfproxy_domains()
                if pool and callable(on_update):
                    on_update(pool)
            except Exception:
                pass
            while True:
                try:
                    if stop.wait(timeout=3600):
                        return
                except Exception:
                    return
                try:
                    pool = _tgws_fetch_cfproxy_domains()
                    if pool and callable(on_update):
                        on_update(pool)
                except Exception:
                    continue
        except Exception:
            return
    try:
        threading.Thread(target=_loop, daemon=True, name="tgws-cfproxy-refresh").start()
    except Exception:
        pass
