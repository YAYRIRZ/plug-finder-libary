# Friendly title shown for our own entry in Telegram's proxy panel. Telegram's
# proxy-list cell hardcodes the title to "address:port" (ProxyInfo has no name
# field), so we relabel only OUR 127.0.0.1 row via a post-hook on the cell.
TGWS_PROXY_LABEL = "Обход блокировок"


class _TgwsProxyLabelHook(MethodHook):
    # Post-hook on ProxyListActivity$TextDetailProxyCell.setProxy(ProxyInfo).
    # After the cell renders "127.0.0.1:port", overwrite the title TextView with
    # a human-readable label — but ONLY for our local entry; all other proxies
    # are left untouched. Fully guarded: any shape mismatch silently no-ops and
    # the row just keeps showing the raw address.
    def after_hooked_method(self, param):
        try:
            args = getattr(param, "args", None)
            if not args:
                return
            info = args[0]
            if info is None:
                return
            if str(getattr(info, "address", "")) != LOCAL_PROXY_HOST:
                return
            cell = getattr(param, "thisObject", None)
            if cell is None:
                return
            tv = get_private_field(cell, "textView")
            if tv is not None:
                tv.setText(TGWS_PROXY_LABEL)
        except Exception:
            pass
# Guards LOCAL_PROXY_HOST mutations and SharedConfig.proxyList iteration/mutation.
# RLock so the same thread can re-enter (e.g. _apply_runtime_local_host -> _local_host).
_TGWS_HOST_LOCK = threading.RLock()
_TGWS_PROXYLIST_LOCK = threading.RLock()
# [v2.1 coexist] guard against re-entrant proxySettingsChanged posts when
# other proxy-management plugins (e.g. th3_proxy_tools.plugin) are active.
_TGWS_NOTIFY_LOCK = threading.Lock()
_TGWS_NOTIFY_IN_FLIGHT = False
# [perf-01 redo] Reflection Field cache. Key f"{cls.getName()}::{name}" is stable
# across plugin reloads (unlike id(cls), which changes when the class is reloaded
# and can be recycled to alias a different class). Lazy-filled under a dedicated
# Lock; getDeclaredField + setAccessible runs once per (class, field).
# ---------------------------------------------------------------------------
# WHY THIS PLUGIN USES JAVA REFLECTION (security-review note)
# ---------------------------------------------------------------------------
# exteraGram exposes no public API to fully drive Telegram's proxy state from a
# plugin. To install its purely-LOCAL 127.0.0.1 MTProto proxy the plugin has to:
#   * set a few SharedConfig statics that have no public setter
#     (useProxySettings, proxyEnabled, currentProxyInfo);
#   * read ProxyInfo's private fields (address/port/username/password/secret) to
#     SNAPSHOT the user's existing proxy so it can be restored verbatim on disable.
# Reflection is therefore used ONLY for these proxy-config fields. It never loads
# code, never reads the filesystem, and never touches unrelated app state. Public
# APIs (SharedConfig.addProxy/deleteProxy, ConnectionsManager.setProxySettings) are
# preferred wherever they exist; reflection is the documented exteraGram-plugin
# fallback for the gaps they leave. Fields are resolved once and cached below.
# ---------------------------------------------------------------------------
_TGWS_FIELD_CACHE = {}
_FIELD_CACHE_LOCK = threading.Lock()
def _tgws_cached_field(cls, name):
    try:
        cls_name = str(cls.getName())
    except Exception:
        cls_name = str(cls)
    key = f"{cls_name}::{name}"
    with _FIELD_CACHE_LOCK:
        try:
            return _TGWS_FIELD_CACHE[key]
        except KeyError:
            f = cls.getDeclaredField(str(name))
            f.setAccessible(True)
            _TGWS_FIELD_CACHE[key] = f
            return f
TGWS_WS_FAIL_COOLDOWN_SEC = 30.0
