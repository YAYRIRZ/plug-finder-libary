TGWS_WS_CONNECT_TIMEOUT_SEC = float(os.getenv("TGWS_WS_CONNECT_TIMEOUT_SEC", "4"))
TGWS_SOFT_START_DELAY_SEC = float(os.getenv("TGWS_SOFT_START_DELAY_SEC", "0"))
# Delay before UI-triggered (re)starts: at least 800 ms to let the old listener die.
TGWS_SOFT_RESTART_DELAY_MS = int(max(800.0, TGWS_SOFT_START_DELAY_SEC * 1000))
# [v2.4.2 warmup] Keep warm CF spares ready so a reconnect skips the TLS+WS
# handshake (the slow, high-ping, DPI-fingerprintable part) and is near-instant.
# ON by default now (the connect() fd-leak it used to re-exercise is fixed below).
TGWS_WARMUP_ON_START = str(os.getenv("TGWS_WARMUP_ON_START", "1") or "1").strip().lower() in ("1", "true", "yes", "y", "on")
TGWS_WARMUP_DELAY_SEC = float(os.getenv("TGWS_WARMUP_DELAY_SEC", "4"))
TGWS_WARMUP_STAGGER_SEC = float(os.getenv("TGWS_WARMUP_STAGGER_SEC", "0.4"))
# How many warm CF spares to keep per active (dc,is_media) key, the global cap,
# how fresh a spare may be (held spares can be silently throttled, so keep them
# young), the top-up cadence, how long a (dc,is_media) counts as "active" since
# last real use, and how many CF domains _warm_one_spare tries before giving up.
TGWS_WS_SPARE_PER_KEY = int(float(os.getenv("TGWS_WS_SPARE_PER_KEY", "2")))
TGWS_WS_SPARE_MAX = int(float(os.getenv("TGWS_WS_SPARE_MAX", "8")))
TGWS_WS_SPARE_MAX_AGE_SEC = float(os.getenv("TGWS_WS_SPARE_MAX_AGE_SEC", "18"))
TGWS_WS_WARM_INTERVAL_SEC = float(os.getenv("TGWS_WS_WARM_INTERVAL_SEC", "3"))
TGWS_WS_ACTIVE_KEY_TTL_SEC = float(os.getenv("TGWS_WS_ACTIVE_KEY_TTL_SEC", "300"))
TGWS_WS_WARM_DOMAINS_TRY = int(float(os.getenv("TGWS_WS_WARM_DOMAINS_TRY", "3")))
# [v2.4.3 keepalive] Hold a quiet-but-ALIVE tunnel instead of tearing it down at the
# first idle gap (that was the "reconnect every few seconds" churn). When the upstream
# is idle for IDLE_PING_SEC, send a WS ping and wait PONG_WAIT_SEC for a pong/data:
# pong/data => alive (keep); nothing => dead/throttled => drop immediately (so a
# strangled tunnel never inflates the ping). A purely-idle-but-alive tunnel is recycled
# only after MAX_IDLE such cycles (~IDLE_PING_SEC*MAX_IDLE seconds) => reconnects drop
# from every few seconds to about once a minute, while active tunnels hold indefinitely.
TGWS_BRIDGE_KEEPALIVE = str(os.getenv("TGWS_BRIDGE_KEEPALIVE", "1") or "1").strip().lower() in ("1", "true", "yes", "y", "on")
TGWS_BRIDGE_IDLE_PING_SEC = float(os.getenv("TGWS_BRIDGE_IDLE_PING_SEC", "20"))
TGWS_BRIDGE_PONG_WAIT_SEC = float(os.getenv("TGWS_BRIDGE_PONG_WAIT_SEC", "5"))
TGWS_BRIDGE_MAX_IDLE = int(float(os.getenv("TGWS_BRIDGE_MAX_IDLE", "3")))
TGWS_AUTOSTART_DELAY_MS = int(float(os.getenv("TGWS_AUTOSTART_DELAY_MS", "0")))
TGWS_RESUME_START_DELAY_MS = int(float(os.getenv("TGWS_RESUME_START_DELAY_MS", "0")))
TGWS_CF_REFRESH_DELAY_SEC = float(os.getenv("TGWS_CF_REFRESH_DELAY_SEC", "45"))
TGWS_SHOW_SUCCESS_BULLETIN = str(os.getenv("TGWS_SHOW_SUCCESS_BULLETIN", "0") or "0").strip().lower() in ("1", "true", "yes", "y", "on")
