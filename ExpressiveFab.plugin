__id__ = "expressive_fab"
__name__ = "Expressive FAB"
__description__ = "Плавающая кнопка в списке чатов с пунктами меню"
__author__ = "@yzewe"
__version__ = "1.0"
__icon__ = "nachoneko3/32"
__app_version__ = ">=12.8.1"
__sdk_version__ = ">=1.4.3.10"

import base64
import hashlib
from android_utils import OnClickListener, run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import get_last_fragment
from java import jclass
from java.nio import ByteBuffer
from org.telegram.messenger import ApplicationLoader, LocaleController


DEX_CLASS = "com.yzewe.expressivefab.ExpressiveFabCore"
DEX_SHA256 = "ca23d3b65e2481f28662561d1f7dea0609ba6abbae8d36f0d8be7bb40e6d1df3"
DEX_B64 = ""


def _class(name):
    try:
        return jclass("java.lang.Class").forName(name)
    except Exception:
        return None


DIALOGS_ACTIVITY = _class("org.telegram.ui.DialogsActivity")
FRAGMENT_FAB = _class("org.telegram.ui.Components.FragmentFloatingButton")


def _field(obj, name, default=None):
    if obj is None:
        return default
    cls = obj.getClass()
    while cls is not None:
        try:
            field = cls.getDeclaredField(name)
            field.setAccessible(True)
            value = field.get(obj)
            return default if value is None else value
        except Exception:
            try:
                cls = cls.getSuperclass()
            except Exception:
                break
    return default


def _click_listener(view):
    try:
        view_class = _class("android.view.View")
        listener_class = _class("android.view.View$ListenerInfo")
        method = view_class.getDeclaredMethod("getListenerInfo")
        method.setAccessible(True)
        info = method.invoke(view)
        if info is None:
            return None
        field = listener_class.getDeclaredField("mOnClickListener")
        field.setAccessible(True)
        return field.get(info)
    except Exception:
        return None


class _DialogsHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fragment = param.thisObject
        run_on_ui_thread(lambda: self.plugin._bind(fragment))


class _DialogsDestroyHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        fragment = param.thisObject
        run_on_ui_thread(lambda: self.plugin._detach_if_bound(fragment))


class _FabColorsHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        fab = param.thisObject
        if fab == self.plugin.bound_fab:
            run_on_ui_thread(lambda: self.plugin._refresh_bound(fab))


class ExpressiveFabPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self.dex_loader = None
        self.dex_class = None
        self.bound_fab = None
        self.bound_fragment = None
        self.original_listener = None
        self.fallback_listener = None
        try:
            locale = LocaleController.getInstance().getCurrentLocaleInfo().shortName
        except Exception:
            locale = "en"
        self.lang = "ru" if str(locale).lower().startswith("ru") else "en"

    def _ui(self, ru, en):
        return ru if self.lang == "ru" else en

    def on_plugin_load(self):
        self._load_dex()
        if DIALOGS_ACTIVITY is None:
            raise RuntimeError("DialogsActivity is unavailable")
        self.hook_all_methods(DIALOGS_ACTIVITY, "createView", _DialogsHook(self))
        self.hook_all_methods(DIALOGS_ACTIVITY, "onResume", _DialogsHook(self))
        self.hook_all_methods(DIALOGS_ACTIVITY, "onFragmentDestroy", _DialogsDestroyHook(self))
        if FRAGMENT_FAB is not None:
            self.hook_all_methods(FRAGMENT_FAB, "updateColors", _FabColorsHook(self))
        run_on_ui_thread(self._bind_current, 100)

    def on_plugin_unload(self):
        try:
            self._invoke("detachBridge")
        except Exception as error:
            self.log("[ExpressiveFab] detach failed: " + str(error))
        finally:
            self.bound_fab = None
            self.bound_fragment = None
            self.original_listener = None
            self.fallback_listener = None
            self.dex_class = None
            self.dex_loader = None

    def _load_dex(self):
        dex_bytes = base64.b64decode(DEX_B64)
        if not dex_bytes.startswith(b"dex\n"):
            raise RuntimeError("Bundled DEX has an invalid header")
        if hashlib.sha256(dex_bytes).hexdigest() != DEX_SHA256:
            raise RuntimeError("Bundled DEX checksum mismatch")

        loader_class = jclass("dalvik.system.InMemoryDexClassLoader")
        self.dex_loader = loader_class(
            ByteBuffer.wrap(dex_bytes),
            ApplicationLoader.applicationContext.getClassLoader(),
        )
        self.dex_class = self.dex_loader.loadClass(DEX_CLASS)
        version = int(self.dex_class.getField("VERSION_CODE").get(None))
        if version != 2:
            raise RuntimeError("Unsupported Expressive FAB DEX version")

        self.dex_class.getMethod(
            "attachBridge",
            jclass("java.lang.Object"),
            jclass("android.view.ViewGroup"),
            jclass("android.view.View"),
            jclass("android.view.View$OnClickListener"),
        )
        self.dex_class.getMethod("detachBridge")
        self.dex_class.getMethod("refreshBridge")

    def _invoke(self, name, *args):
        if self.dex_class is None:
            return None
        if name == "attachBridge":
            method = self.dex_class.getMethod(
                name,
                jclass("java.lang.Object"),
                jclass("android.view.ViewGroup"),
                jclass("android.view.View"),
                jclass("android.view.View$OnClickListener"),
            )
        elif name == "isAttachedBridge":
            method = self.dex_class.getMethod(name, jclass("android.view.View"))
        else:
            method = self.dex_class.getMethod(name)
        return method.invoke(None, *args)

    def _bind_current(self):
        try:
            self._bind(get_last_fragment())
        except Exception as error:
            self.log("[ExpressiveFab] current fragment failed: " + str(error))

    def _refresh_bound(self, fab):
        if self.dex_class is None or fab != self.bound_fab:
            return
        try:
            self._invoke("refreshBridge")
        except Exception as error:
            self.log("[ExpressiveFab] refresh failed: " + str(error))

    def _detach_if_bound(self, fragment):
        if fragment != self.bound_fragment:
            return
        try:
            self._invoke("detachBridge")
        finally:
            self.bound_fab = None
            self.bound_fragment = None
            self.original_listener = None
            self.fallback_listener = None

    def _is_main_dialogs(self, fragment):
        if fragment is None or DIALOGS_ACTIVITY is None:
            return False
        try:
            if not DIALOGS_ACTIVITY.isInstance(fragment):
                return False
        except Exception:
            return False
        return (
            not bool(_field(fragment, "onlySelect", False))
            and int(_field(fragment, "initialDialogsType", 0)) == 0
            and int(_field(fragment, "folderId", 0)) == 0
            and int(_field(fragment, "communityId", 0)) == 0
        )

    def _bind(self, fragment):
        if self.dex_class is None or not self._is_main_dialogs(fragment):
            return
        fab = _field(fragment, "floatingButton3")
        root = _field(fragment, "fragmentView")
        if fab is None or root is None:
            return

        if fab == self.bound_fab:
            self.bound_fragment = fragment
            self._invoke("refreshBridge")
            return

        try:
            if self.bound_fab is not None:
                self._invoke("detachBridge")
            listener = _click_listener(fab)
            if listener is None:
                listener = self._fallback_contacts_listener(fragment)
            self.original_listener = listener
            self.bound_fab = fab
            self.bound_fragment = fragment
            self._invoke("attachBridge", fragment, root, fab, listener)
        except Exception:
            self.bound_fab = None
            self.bound_fragment = None
            self.original_listener = None
            raise

    def _fallback_contacts_listener(self, fragment):
        def open_contacts(_view):
            try:
                Bundle = jclass("android.os.Bundle")
                ContactsActivity = jclass("org.telegram.ui.ContactsActivity")
                args = Bundle()
                args.putBoolean("destroyAfterSelect", True)
                fragment.presentFragment(ContactsActivity(args))
            except Exception as error:
                self.log("[ExpressiveFab] contacts fallback failed: " + str(error))

        self.fallback_listener = OnClickListener(open_contacts)
        return self.fallback_listener
