            text = resolved
            if not check_language(text):
                send_message({"peer": peer, "message": f"❌ Язык текста не соответствует настройке '{PLUGIN_SETTINGS.get('lang', 'не задан')}'"})
                SPAM_ACTIVE = False
                return HookResult(strategy=HookStrategy.CANCEL)
            words = text.split()
            def lag_send():
                for w in words:
                    if STOP_EVENT.is_set():
                        break
                    while PAUSE_EVENT.is_set() and not STOP_EVENT.is_set():
                        time.sleep(0.05)
                    if STOP_EVENT.is_set():
                        break
                    send_message({"peer": peer, "message": w})
                    time.sleep(random.uniform(0.1, 2.0))
                SPAM_ACTIVE = False
            threading.Thread(target=lag_send, daemon=True).start()
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".trolrepeat "):
            raw = msg[len(".trolrepeat "):].strip()
            parts = raw.split(maxsplit=1)
            if len(parts) < 2:
                send_message({"peer": peer, "message": "❌ Формат: .trolrepeat <кол-во> <текст|шаблон>"})
                return HookResult(strategy=HookStrategy.CANCEL)
            try:
                count = int(parts[0])
                if count <= 0 or count > 100:
                    raise ValueError
            except:
                send_message({"peer": peer, "message": "❌ Укажите число от 1 до 100"})
                return HookResult(strategy=HookStrategy.CANCEL)
            rest = parts[1]
            text, delay_ms, jitter_pct = parse_params(rest)
            raw_key = rest.strip().split('|')[0].strip().lower()
            resolved = resolve_template_or_text(raw_key) if raw_key in TEMPLATES else resolve_template_or_text(text)
            if resolved is None:
                send_message({"peer": peer, "message": f"❌ Шаблон '{raw_key}' отключён."})
                return HookResult(strategy=HookStrategy.CANCEL)
            text = resolved
            if not check_language(text):
                send_message({"peer": peer, "message": f"❌ Язык текста не соответствует настройке '{PLUGIN_SETTINGS.get('lang', 'не задан')}'"})
                return HookResult(strategy=HookStrategy.CANCEL)
            big_text = (text + " ") * count
            big_text = big_text.strip()
            if len(big_text) > 4096:
                big_text = big_text[:4093] + "..."
            send_message({"peer": peer, "message": big_text})
            return HookResult(strategy=HookStrategy.CANCEL)

        # ====== КОМАНДА .troltimer (без уведомления) ======
        if msg.startswith(".troltimer "):
            raw = msg[len(".troltimer "):].strip()
            parts = raw.split(maxsplit=1)
            if len(parts) < 2:
                send_message({"peer": peer, "message": "❌ Формат: .troltimer <время> <команда>"})
                return HookResult(strategy=HookStrategy.CANCEL)
            time_str = parts[0]
            cmd_text = parts[1]
            try:
                delay_sec = parse_time_to_seconds(time_str)
                if delay_sec <= 0:
                    raise ValueError
            except Exception as e:
                send_message({"peer": peer, "message": f"❌ Ошибка в формате времени: {e}"})
                return HookResult(strategy=HookStrategy.CANCEL)
            # Запускаем таймер без уведомления
            threading.Timer(delay_sec, self.execute_command, args=(peer, cmd_text)).start()
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".delshabl "):
            raw = msg[len(".delshabl "):].strip()
            if not raw:
                send_message({"peer": peer, "message": "❌ Укажите имя шаблона"})
                return HookResult(strategy=HookStrategy.CANCEL)
            name = raw.lower()
            if name in TEMPLATES:
                del TEMPLATES[name]
                if name in PLUGIN_SETTINGS["disabled_templates"]:
                    PLUGIN_SETTINGS["disabled_templates"].remove(name)
                send_message({"peer": peer, "message": f"✅ Шаблон '{name}' удалён."})
            else:
                send_message({"peer": peer, "message": f"❌ Шаблон '{name}' не найден."})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".toggletpl "):
            raw = msg[len(".toggletpl "):].strip()
            if not raw:
                send_message({"peer": peer, "message": "❌ Укажите имя шаблона"})
                return HookResult(strategy=HookStrategy.CANCEL)
            name = raw.lower()
            if name not in TEMPLATES:
                send_message({"peer": peer, "message": f"❌ Шаблон '{name}' не найден."})
                return HookResult(strategy=HookStrategy.CANCEL)
            if name in PLUGIN_SETTINGS["disabled_templates"]:
                PLUGIN_SETTINGS["disabled_templates"].remove(name)
                send_message({"peer": peer, "message": f"✅ Шаблон '{name}' включён."})
            else:
                PLUGIN_SETTINGS["disabled_templates"].append(name)
                send_message({"peer": peer, "message": f"❌ Шаблон '{name}' отключён."})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".togglecmd "):
            raw = msg[len(".togglecmd "):].strip()
            if not raw:
                send_message({"peer": peer, "message": "❌ Укажите команду (без точки)"})
                return HookResult(strategy=HookStrategy.CANCEL)
            cmd_name = raw.lstrip('.').lower()
            if cmd_name in PLUGIN_SETTINGS["disabled_commands"]:
                PLUGIN_SETTINGS["disabled_commands"].remove(cmd_name)
                send_message({"peer": peer, "message": f"✅ Команда .{cmd_name} включена."})
            else:
                PLUGIN_SETTINGS["disabled_commands"].append(cmd_name)
                send_message({"peer": peer, "message": f"❌ Команда .{cmd_name} отключена."})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".trollang "):
            raw = msg[len(".trollang "):].strip()
            parts = raw.split(maxsplit=1)
            if len(parts) < 2:
                send_message({"peer": peer, "message": "❌ Формат: .trollang <язык> <текст|шаблон>"})
                return HookResult(strategy=HookStrategy.CANCEL)
            lang_code = parts[0].lower()
            rest = parts[1]
            text, delay_ms, jitter_pct = parse_params(rest)
            raw_key = rest.strip().split('|')[0].strip().lower()
            resolved = resolve_template_or_text(raw_key) if raw_key in TEMPLATES else resolve_template_or_text(text)
            if resolved is None:
                send_message({"peer": peer, "message": f"❌ Шаблон '{raw_key}' отключён."})
                return HookResult(strategy=HookStrategy.CANCEL)
            text = resolved
            if not HAS_LANGDETECT:
                send_message({"peer": peer, "message": "❌ Библиотека langdetect не установлена."})
                return HookResult(strategy=HookStrategy.CANCEL)
            try:
                detected = detect(text)
            except:
                detected = "unknown"
            if detected == lang_code:
                words = text.split()
                run_on_queue(lambda: send_words(peer, words, delay_ms, jitter_pct))
            else:
                send_message({"peer": peer, "message": f"❌ Язык текста не соответствует '{lang_code}' (обнаружен: {detected})"})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.strip() == ".trolsettings":
            status = "📋 Настройки плагина:\n"
            status += f"🔤 Язык: {PLUGIN_SETTINGS.get('lang', 'не задан')}\n"
            status += f"🔒 Принудительная проверка: {PLUGIN_SETTINGS.get('enforce_lang', False)}\n"
            status += f"🚫 Отключённые команды: {PLUGIN_SETTINGS.get('disabled_commands', []) or 'нет'}\n"
            status += f"🚫 Отключённые шаблоны: {PLUGIN_SETTINGS.get('disabled_templates', []) or 'нет'}"
            send_message({"peer": peer, "message": status})
            return HookResult(strategy=HookStrategy.CANCEL)

        return HookResult()