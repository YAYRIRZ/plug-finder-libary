class TrolPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        print("[Trol] Плагин загружен (упрощённая версия)")

    def execute_command(self, peer: int, cmd: str):
        class FakeParams:
            def __init__(self, peer, message):
                self.peer = peer
                self.message = message
        fake_params = FakeParams(peer, cmd)
        self.on_send_message_hook(0, fake_params)

    def on_send_message_hook(self, account: int, params: Any) -> HookStrategy:
        global SPAM_ACTIVE, SPAM_STARTED_AT
        global LAST_PING_MS

        msg = params.message if isinstance(params.message, str) else ""
        if not msg:
            return HookResult()

        peer = params.peer if hasattr(params, 'peer') else None
        if not peer:
            return HookResult()

        # Проверка отключённых команд
        cmd_name = msg.split()[0].lstrip('.') if msg.startswith('.') else ''
        if cmd_name in PLUGIN_SETTINGS.get("disabled_commands", []):
            return HookResult()

        if msg.strip() == ".ping":
            t0 = time.time()
            send_message({"peer": peer, "message": "🏓 Pong"})
            LAST_PING_MS = int((time.time() - t0) * 1000)
            send_message({"peer": peer, "message": f"🏓 Ping: {LAST_PING_MS} ms"})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.strip() == ".шаб":
            send_message({"peer": peer, "message": HELQ_TEXT})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.strip() == ".trolstatus":
            ping_line = f"\n🏓 Ping: {LAST_PING_MS} ms" if LAST_PING_MS is not None else ""
            if not SPAM_ACTIVE:
                send_message({"peer": peer, "message": "🔴 Статус: неактивен" + ping_line})
                return HookResult(strategy=HookStrategy.CANCEL)
            state = "⏸ на паузе" if PAUSE_EVENT.is_set() else "🟢 активен"
            uptime = int(time.time() - SPAM_STARTED_AT)
            send_message({"peer": peer, "message": f"{state}\n⏱ Работает: {uptime} сек{ping_line}"})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".addshabl "):
            raw = msg[len(".addshabl "):].strip()
            if not raw:
                send_message({"peer": peer, "message": "❌ Формат: .addshabl <имя> <текст>"})
                return HookResult(strategy=HookStrategy.CANCEL)
            parts = raw.split(maxsplit=1)
            name = parts[0].strip().lower()
            text = parts[1] if len(parts) > 1 else ""
            if not name or not text:
                send_message({"peer": peer, "message": "❌ Формат: .addshabl <имя> <текст>"})
                return HookResult(strategy=HookStrategy.CANCEL)
            if len(name) > 32:
                send_message({"peer": peer, "message": "❌ Имя слишком длинное (до 32 символов)"})
                return HookResult(strategy=HookStrategy.CANCEL)
            TEMPLATES[name] = text
            send_message({"peer": peer, "message": f"✅ Шаблон добавлен: {name}"})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.strip() == ".stop":
            STOP_EVENT.set()
            PAUSE_EVENT.clear()
            SPAM_ACTIVE = False
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.strip() == ".pause":
            PAUSE_EVENT.set()
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.strip() == ".resume":
            PAUSE_EVENT.clear()
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.strip() == ".help":
            send_message({"peer": peer, "message": HELP_TEXT})
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".spam "):
            STOP_EVENT.clear()
            SPAM_ACTIVE = True
            SPAM_STARTED_AT = time.time()
            raw = msg[len(".spam "):]
            word, count, delay_ms, jitter_pct = parse_spam_args(raw, DEFAULT_DELAY_MS)
            run_on_queue(lambda: send_spam(peer, word, count, delay_ms, jitter_pct))
            return HookResult(strategy=HookStrategy.CANCEL)

        if msg.startswith(".spam2 "):
            STOP_EVENT.clear()
            SPAM_ACTIVE = True
            SPAM_STARTED_AT = time.time()
            raw = msg[len(".spam2 "):].strip()
            count = 5
            delay_ms = DEFAULT_DELAY_MS
            text_part = raw
            m = re.search(r'\((\d+)\)', raw)
            if m:
                try:
                    count = max(1, min(100, int(m.group(1))))
                except:
                    count = 5
                text_part = raw[:m.start()] + raw[m.end():]
            if "|" in text_part:
                text_part, tail = text_part.split("|", 1)
                text_part = text_part.strip()
                tail = tail.strip()
                m_delay = re.search(r"(\d+)", tail)
                if m_delay:
                    try:
                        delay_ms = max(0, int(m_delay.group(1)))
                    except:
                        delay_ms = DEFAULT_DELAY_MS
            text_part = text_part.strip()
            if not text_part:
                send_message({"peer": peer, "message": "❌ Укажите текст для спама"})
                SPAM_ACTIVE = False
                return HookResult(strategy=HookStrategy.CANCEL)
            raw_key = text_part.strip().lower()
            resolved = resolve_template_or_text(raw_key) if raw_key in TEMPLATES else resolve_template_or_text(text_part)
            if resolved is None:
                send_message({"peer": peer, "message": f"❌ Шаблон '{raw_key}' отключён."})
                SPAM_ACTIVE = False
                return HookResult(strategy=HookStrategy.CANCEL)
            text = resolved
            if not check_language(text):
                send_message({"peer": peer, "message": f"❌ Язык текста не соответствует настройке '{PLUGIN_SETTINGS.get('lang', 'не задан')}'"})
                SPAM_ACTIVE = False
                return HookResult(strategy=HookStrategy.CANCEL)
            def send_spam2():
                for _ in range(count):
                    if STOP_EVENT.is_set():
                        break
                    while PAUSE_EVENT.is_set() and not STOP_EVENT.is_set():
                        time.sleep(0.05)
                    if STOP_EVENT.is_set():
                        break
                    send_message({"peer": peer, "message": text})
                    if delay_ms > 0:
                        time.sleep(delay_ms / 1000.0)
                SPAM_ACTIVE = False
            threading.Thread(target=send_spam2, daemon=True).start()
            return HookResult(strategy=HookStrategy.CANCEL)

        # ====== ОСНОВНЫЕ КОМАНДЫ ======
        if msg.startswith(".trol "):
            STOP_EVENT.clear()
            SPAM_ACTIVE = True
            SPAM_STARTED_AT = time.time()
            raw = msg[len(".trol "):]
            text, delay_ms, jitter_pct = parse_params(raw)
            raw_key = raw.strip().split('|')[0].strip().lower()
            resolved = resolve_template_or_text(raw_key) if raw_key in TEMPLATES else resolve_template_or_text(text)
            if resolved is None:
                send_message({"peer": peer, "message": f"❌ Шаблон '{raw_key}' отключён."})
                SPAM_ACTIVE = False
                return HookResult(strategy=HookStrategy.CANCEL)
            text = resolved
            if not check_language(text):
                send_message({"peer": peer, "message": f"❌ Язык текста не соответствует настройке '{PLUGIN_SETTINGS.get('lang', 'не задан')}'"})
                SPAM_ACTIVE = False
                return HookResult(strategy=HookStrategy.CANCEL)
            words = text.split()
