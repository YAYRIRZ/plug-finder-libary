# -*- coding: utf-8 -*-

# Сгенерировано в PluginGRT - @PluginIDEbot

from base_plugin import BasePlugin

# --- Метаданные Плагина ---
# Это обязательные поля, которые exteraGram использует для отображения информации о плагине.
__id__ = "minimal_example_pg"
__name__ = "Минимальный пример"
__description__ = "Это самый базовый, но полностью рабочий пример плагина для exteraGram. Он ничего не делает, кроме как выводит сообщение в лог при загрузке и выгрузке."
__version__ = "1.0.0"
__author__ = "@exteraRooni & @PluginIDEbot"
__icon__ = "sPluginIDE/10"  # Иконка гаечного ключа, как символ утилиты/примера
__min_version__ = "11.12.0"


class MinimalPlugin(BasePlugin):
    """
    Минимальный пример класса плагина.
    Он наследуется от BasePlugin и реализует только два основных метода жизненного цикла.
    """

    def on_plugin_load(self):
        """
        Этот метод вызывается один раз, когда плагин активируется (включается).
        Идеальное место для любой начальной настройки или инициализации.
        """
        # Выводим сообщение в логи exteraGram.
        # Вы можете найти их в "Инструменты -> Логи" в приложении.
        # Это самый простой способ проверить, что плагин загрузился. #>^_^<#
        self.log(f"Плагин '{__name__}' версии {__version__} успешно загружен!")

    def on_plugin_unload(self):
        """
        Этот метод вызывается, когда плагин деактивируется (выключается).
        Используется для очистки ресурсов, если плагин их занимал.
        """
        self.log(f"Плагин '{__name__}' был выгружен.")